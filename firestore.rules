        && getAfter(/databases/$(database)/documents/libraries/$(owner)/catalog/$(request.resource.data.catalogId)).data.catalogKey == key
        && getAfter(/databases/$(database)/documents/libraries/$(owner)/entries/$(request.resource.data.entryId)).data.catalogId == request.resource.data.catalogId;
    }
    match /libraries/{owner}/entries/{id} {
      function validEntry(data) {
        return data.keys().hasAll(['schemaVersion', 'ownerId', 'catalogId', 'mediaType', 'state', 'favorite', 'isShared', 'legacyRef', 'createdAt', 'updatedAt', 'revision'])
          && data.keys().hasOnly(['schemaVersion', 'ownerId', 'catalogId', 'mediaType', 'state', 'favorite', 'isShared', 'legacyRef', 'createdAt', 'updatedAt', 'revision'])
          && data.schemaVersion == 1 && data.ownerId == owner
          && data.isShared == false && data.legacyRef == null
          && data.revision is int && data.revision >= 1
