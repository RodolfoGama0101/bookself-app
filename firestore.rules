    function validProgress(id, data) {
      let book = bibleBooks()[data.bookName];
      return data.keys().hasAll(['userId', 'bookName', 'readChapters', 'updatedAt'])
        && data.get('isShared', true) is bool
        && id == data.userId + '_' + book.id
        && data.readChapters is list
        && data.readChapters.size() == data.readChapters.toSet().size()
        && data.readChapters.hasOnly(allowedChapters(book.chapters))
        && data.updatedAt == request.time;
    }
    match /bible_progress/{id} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/bible_progress/$(id))
        || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && validProgress(id, request.resource.data)
        && request.resource.data.keys().hasOnly(['userId', 'bookName', 'readChapters', 'updatedAt', 'isShared']);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'bookName', 'readChapters', 'updatedAt', 'isShared'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.bookName == resource.data.bookName
        && validProgress(id, request.resource.data)
        && (request.resource.data.get('isShared', true) || !existsAfter(/databases/$(database)/documents/shared_bible_progress/$(id)))
        && (!existsAfter(/databases/$(database)/documents/shared_bible_progress/$(id))
          || getAfter(/databases/$(database)/documents/shared_bible_progress/$(id)).data.readChapters == request.resource.data.readChapters);
      allow delete: if isOwner(resource.data.userId)
        && !existsAfter(/databases/$(database)/documents/shared_bible_progress/$(id));
    }
    match /shared_bible_progress/{id} {
      allow get: if signedIn() && ((!exists(/databases/$(database)/documents/shared_bible_progress/$(id))
        && isOwner(get(/databases/$(database)/documents/bible_progress/$(id)).data.userId)) || canRead(resource.data.userId));
      allow list: if canRead(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(['userId', 'bookName', 'readChapters', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/bible_progress/$(id)).data.get('isShared', true)
        && request.resource.data.userId == getAfter(/databases/$(database)/documents/bible_progress/$(id)).data.userId
        && request.resource.data.bookName == getAfter(/databases/$(database)/documents/bible_progress/$(id)).data.bookName
        && request.resource.data.readChapters == getAfter(/databases/$(database)/documents/bible_progress/$(id)).data.readChapters
        && request.resource.data.updatedAt == getAfter(/databases/$(database)/documents/bible_progress/$(id)).data.updatedAt;
