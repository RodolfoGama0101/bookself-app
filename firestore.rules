    // Base DATA-02 privada e aditiva. Sem compartilhamento, importação ou exclusão.
    function mediaText(value) { return value is string && value.size() > 0; }
    function mediaNullableText(value) { return value == null || mediaText(value); }
    function mediaDate(value) {
      return value == null || (value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
    }
    function mediaYear(value) { return value == null || (value is int && value >= 1 && value <= 9999); }
    function mediaMetadata(type, data) {
      let cover = data.get('coverUrl', null);
      return data is map && mediaText(data.title)
        && (cover == null || (cover is string && cover.matches('^https://[^/]+.*$')))
        && ((type == 'book'
          && data.keys().hasOnly(['title', 'authors', 'coverUrl', 'publishedDate'])
          && data.authors is list
          && (data.get('publishedDate', null) == null || (data.publishedDate is string
            && data.publishedDate.matches('^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$'))))
        || (type == 'movie' && data.keys().hasOnly(['title', 'releaseYear', 'coverUrl'])
          && mediaYear(data.get('releaseYear', null)))
        || (type == 'series' && data.keys().hasOnly(['title', 'releaseYear', 'coverUrl', 'productionStatus'])
          && mediaYear(data.get('releaseYear', null)) && mediaNullableText(data.get('productionStatus', null)))
        || (type == 'track' && data.keys().hasOnly(['title', 'artists', 'albumTitle', 'version', 'durationMs', 'coverUrl'])
          && data.artists is list && data.artists.size() > 0
          && mediaNullableText(data.get('albumTitle', null)) && mediaNullableText(data.get('version', null))
          && (data.get('durationMs', null) == null || (data.durationMs is int && data.durationMs >= 0)))
        || (type == 'album' && data.keys().hasOnly(['title', 'artists', 'releaseYear', 'edition', 'coverUrl'])
          && data.artists is list && data.artists.size() > 0
          && mediaYear(data.get('releaseYear', null)) && mediaNullableText(data.get('edition', null))));
    }
    function mediaIdentity(owner, identity) {
      return identity is map && ((identity.kind == 'external'
        && identity.keys().hasAll(['kind', 'provider', 'externalId'])
        && identity.keys().hasOnly(['kind', 'provider', 'externalId'])
        && identity.provider is string && identity.provider.matches('^[a-z][a-z0-9_]{0,63}$')
        && mediaText(identity.externalId))
        || (identity.kind == 'manual' && identity.keys().hasOnly(['kind', 'ownerId', 'manualId'])
          && identity.ownerId == owner && mediaText(identity.manualId)));
    }
    function mediaState(type, state, favorite) {
      return favorite is bool && (((type == 'track' || type == 'album') && state == null)
        || (!favorite && state is map && (
          (type == 'book' && state.keys().hasOnly(['status', 'finishedOn'])
            && state.status in ['planned', 'reading', 'completed']
            && mediaDate(state.get('finishedOn', null))
            && (state.status == 'completed' || state.get('finishedOn', null) == null))
          || (type == 'movie' && state.keys().hasOnly(['status', 'watchedOn'])
            && state.status in ['planned', 'watched'] && mediaDate(state.get('watchedOn', null))
            && (state.status == 'watched' || state.get('watchedOn', null) == null))
          || (type == 'series' && state.keys().hasOnly(['status'])
            && state.status in ['in_progress', 'up_to_date', 'completed', 'paused']))));
    }
    match /libraries/{owner}/catalog/{id} {
      allow read: if isOwner(owner);
      allow create: if isOwner(owner)
        && request.resource.data.keys().hasAll(['schemaVersion', 'ownerId', 'identity', 'mediaType', 'metadata', 'catalogKey', 'fetchedAt'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerId', 'identity', 'mediaType', 'metadata', 'catalogKey', 'fetchedAt'])
        && request.resource.data.schemaVersion == 1 && request.resource.data.ownerId == owner
