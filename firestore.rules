rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isPartner(uid) {
      return signedIn() && uid is string && uid != request.auth.uid
        && get(userPath(request.auth.uid)).data.get('partnerUid', null) == uid
        && get(userPath(uid)).data.get('partnerUid', null) == request.auth.uid;
    }
    function canRead(uid) { return isOwner(uid) || isPartner(uid); }
    function nullableString(value) { return value == null || value is string; }
    function blockPath(uid, other) { return /databases/$(database)/documents/partner_blocks/$(uid)/targets/$(other); }
    function contactPath(uid, other) { return /databases/$(database)/documents/partner_contacts/$(uid)/targets/$(other); }
    function notBlocked(a, b) { return !exists(blockPath(a, b)) && !exists(blockPath(b, a)); }

    function invitePath(code) { return /databases/$(database)/documents/partner_invites/$(code); }
    function slotPath(uid) { return /databases/$(database)/documents/partner_invite_slots/$(uid); }
    function pending(data) {
      return data.status == 'pending' && request.time < data.createdAt + duration.value(7, 'd');
    }
    function free(uid) { return get(userPath(uid)).data.get('partnerUid', null) == null; }
    function epoch(uid) { return get(userPath(uid)).data.get('coupleEpoch', 0); }
    function usable(data) {
      return pending(data) && data.senderEpoch == epoch(data.senderUid)
        && (data.recipientUid == null || notBlocked(data.senderUid, data.recipientUid))
        && (data.recipientUid == null || data.recipientEpoch == epoch(data.recipientUid));
    }
    function currentInvite(code, sender) { return get(slotPath(sender)).data.code == code; }
    function lookupPath(uid) { return /databases/$(database)/documents/partner_invite_lookups/$(uid); }
    function lookedUp(code) {
      let lookup = get(lookupPath(request.auth.uid)).data;
      return lookup.code == code && request.time < lookup.requestedAt + duration.value(1, 'm');
    }
    function outgoingClosed(uid) {
      return !exists(slotPath(uid)) || getAfter(invitePath(get(slotPath(uid)).data.code)).data.status != 'pending';
    }
    function linkPair(uid, before, after) {
      let code = request.resource.data.get('relationshipId', null);
      let invitation = get(invitePath(code)).data;
      return before == null && after is string && after != uid
        && code is string && usable(invitation)
        && invitation.recipientUid == request.auth.uid
        && ((invitation.senderUid == uid && invitation.recipientUid == after)
          || (invitation.senderUid == after && invitation.recipientUid == uid))
        && getAfter(invitePath(code)).data.status == 'accepted'
        && free(after) && getAfter(userPath(after)).data.partnerUid == uid
        && getAfter(userPath(after)).data.relationshipId == code
        && request.resource.data.coupleEpoch == epoch(uid) + 1
        && getAfter(userPath(after)).data.coupleEpoch == epoch(after) + 1;
    }
    // Usa o vínculo persistido: um lote antigo não pode desfazer novo parceiro.
    function unlinkPair(uid, before, after) {
      return before is string && before != uid && after == null
        && (request.auth.uid == uid || request.auth.uid == before)
        && get(userPath(before)).data.get('partnerUid', null) == uid
        && getAfter(userPath(before)).data.get('partnerUid', null) == null;
    }

    function contactFromInvitation(uid, other, data) {
      let invitation = getAfter(invitePath(data.invitationCode)).data;
      return data.invitationCode is string
        && (request.auth.uid == invitation.senderUid || request.auth.uid == invitation.recipientUid)
        && ((uid == invitation.senderUid && other == invitation.recipientUid && data.name == invitation.recipientName)
          || (uid == invitation.recipientUid && other == invitation.senderUid && data.name == invitation.senderName));
    }
    function contactFromRelationship(uid, other, data) {
      return data.invitationCode == null && (isOwner(uid) || isOwner(other))
        && get(userPath(uid)).data.get('partnerUid', null) == other
        && get(userPath(other)).data.get('partnerUid', null) == uid
        && (data.name == 'Pessoa conhecida' || data.name == get(userPath(other)).data.name
          || (exists(contactPath(uid, other)) && data.name == get(contactPath(uid, other)).data.name));
    }
    match /partner_contacts/{uid}/targets/{other} {
      allow read: if isOwner(uid);
      allow create, update: if signedIn() && uid != other
        && request.resource.data.keys().hasAll(['name', 'invitationCode'])
        && request.resource.data.keys().hasOnly(['name', 'invitationCode'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && (contactFromRelationship(uid, other, request.resource.data)
          || contactFromInvitation(uid, other, request.resource.data));
      allow delete: if false;
    }
    match /partner_blocks/{uid}/targets/{other} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && other != uid
        && ((get(userPath(uid)).data.get('partnerUid', null) == other
          && getAfter(userPath(uid)).data.get('partnerUid', null) == null
          && getAfter(userPath(other)).data.get('partnerUid', null) == null)
          || (get(userPath(uid)).data.get('partnerUid', null) != other
            && exists(contactPath(uid, other))
            && request.resource.data.name == get(contactPath(uid, other)).data.name
            && getAfter(userPath(uid)).data.lastBlockedUid == other
            && getAfter(userPath(uid)).data.coupleEpoch == epoch(uid) + 1))
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    match /users/{uid} {
      // O documento legado continua privado, inclusive para o parceiro.
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'createdAt', 'partnerUid', 'photoUrl'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.get('email', null)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.get('partnerUid', null) == null
        && request.resource.data.get('photoUrl', null) == null;
      allow update: if signedIn() && (
        (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoUrl'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && nullableString(request.resource.data.get('photoUrl', null)))
        || (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleEpoch', 'lastBlockedUid'])
          && request.resource.data.lastBlockedUid is string
          && request.resource.data.coupleEpoch == epoch(uid) + 1
          && !exists(blockPath(uid, request.resource.data.lastBlockedUid))
          && getAfter(blockPath(uid, request.resource.data.lastBlockedUid)).data.createdAt == request.time)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerUid', 'relationshipId', 'coupleEpoch'])
          && (linkPair(uid, resource.data.get('partnerUid', null), request.resource.data.get('partnerUid', null))
            || (request.resource.data.get('relationshipId', null) == null
              && (request.resource.data.get('coupleEpoch', 0) == resource.data.get('coupleEpoch', 0)
                || (isOwner(uid) && request.resource.data.coupleEpoch == epoch(uid) + 1
                  && existsAfter(blockPath(uid, resource.data.partnerUid))))
              && unlinkPair(uid, resource.data.get('partnerUid', null), request.resource.data.get('partnerUid', null)))))
      );
    }

    function validInvitation(data) {
      return data.keys().hasAll(['version', 'senderUid', 'senderEpoch', 'senderName', 'senderPhotoUrl', 'recipientUid', 'recipientEpoch', 'recipientName', 'recipientPhotoUrl', 'status', 'createdAt', 'decidedAt'])
        && data.keys().hasOnly(['version', 'senderUid', 'senderEpoch', 'senderName', 'senderPhotoUrl', 'recipientUid', 'recipientEpoch', 'recipientName', 'recipientPhotoUrl', 'status', 'createdAt', 'decidedAt'])
        && data.version == 1 && data.senderUid is string
        && data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 200
        && nullableString(data.senderPhotoUrl) && nullableString(data.recipientUid)
        && nullableString(data.recipientName) && nullableString(data.recipientPhotoUrl)
        && data.senderEpoch is int && data.senderEpoch >= 0
        && (data.recipientEpoch == null || (data.recipientEpoch is int && data.recipientEpoch >= 0))
        && data.createdAt is timestamp;
    }
    match /partner_invite_slots/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create, update: if isOwner(uid) && free(uid)
        && request.resource.data.keys().hasOnly(['code', 'issuedAt'])
        && request.resource.data.code.matches('^[a-f0-9]{32}$')
        && request.resource.data.issuedAt == request.time
        && (!exists(slotPath(uid)) || (!pending(get(invitePath(resource.data.code)).data)
          && request.time >= resource.data.issuedAt + duration.value(1, 'm')))
        && !exists(invitePath(request.resource.data.code))
        && getAfter(invitePath(request.resource.data.code)).data.senderUid == uid
        && getAfter(invitePath(request.resource.data.code)).data.status == 'pending';
    }
    match /partner_invites/{code} {
      // Capacidade aleatória para descoberta pontual, sem listagem pública.
      allow get: if signedIn() && (resource.data.senderUid == request.auth.uid
        || resource.data.recipientUid == request.auth.uid
        || (resource.data.recipientUid == null && pending(resource.data) && lookedUp(code)
          && notBlocked(request.auth.uid, resource.data.senderUid)));
      allow list, delete: if false;
      allow create: if signedIn() && code.matches('^[a-f0-9]{32}$')
        && validInvitation(request.resource.data) && free(request.auth.uid)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEpoch == epoch(request.auth.uid)
        && request.resource.data.senderName == get(userPath(request.auth.uid)).data.name
        && request.resource.data.senderPhotoUrl == get(userPath(request.auth.uid)).data.get('photoUrl', null)
        && request.resource.data.recipientUid == null && request.resource.data.recipientEpoch == null && request.resource.data.recipientName == null
        && request.resource.data.recipientPhotoUrl == null && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time && request.resource.data.decidedAt == null
        && getAfter(slotPath(request.auth.uid)).data.code == code
        && getAfter(slotPath(request.auth.uid)).data.issuedAt == request.time;
      allow update: if signedIn() && validInvitation(request.resource.data) && (
        (usable(resource.data) && resource.data.recipientUid == null
          && lookedUp(code)
          && request.auth.uid != resource.data.senderUid && free(request.auth.uid) && free(resource.data.senderUid)
          && notBlocked(request.auth.uid, resource.data.senderUid)
          && currentInvite(code, resource.data.senderUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipientUid', 'recipientEpoch', 'recipientName', 'recipientPhotoUrl'])
          && request.resource.data.recipientUid == request.auth.uid
          && request.resource.data.recipientEpoch == epoch(request.auth.uid)
          && request.resource.data.recipientName == get(userPath(request.auth.uid)).data.name
          && request.resource.data.recipientPhotoUrl == get(userPath(request.auth.uid)).data.get('photoUrl', null))
        || (resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
          && request.resource.data.decidedAt == request.time && (
            (request.resource.data.status == 'cancelled' && resource.data.senderUid == request.auth.uid)
            || (request.resource.data.status == 'declined' && resource.data.recipientUid == request.auth.uid)
            || (request.resource.data.status == 'accepted' && usable(resource.data)
              && resource.data.recipientUid == request.auth.uid && currentInvite(code, resource.data.senderUid)
              && free(resource.data.senderUid) && free(request.auth.uid) && outgoingClosed(request.auth.uid)
              && getAfter(userPath(resource.data.senderUid)).data.partnerUid == request.auth.uid
              && getAfter(userPath(resource.data.senderUid)).data.relationshipId == code
              && getAfter(userPath(request.auth.uid)).data.partnerUid == resource.data.senderUid
              && getAfter(userPath(request.auth.uid)).data.relationshipId == code))));
    }

    match /partner_invite_lookups/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create, update: if isOwner(uid) && free(uid)
        && request.resource.data.keys().hasOnly(['code', 'requestedAt'])
        && request.resource.data.code.matches('^[a-f0-9]{32}$')
        && request.resource.data.requestedAt == request.time
        && (!exists(lookupPath(uid)) || request.time >= resource.data.requestedAt + duration.value(5, 's'));
    }

    function validPartnerProfile(data) {
      return data.keys().hasAll(['name'])
        && data.keys().hasOnly(['name', 'photoUrl'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && nullableString(data.get('photoUrl', null));
    }
    match /partner_profiles/{uid} {
      allow get: if isOwner(uid) || (isPartner(uid)
        && (!exists(/databases/$(database)/documents/partner_profiles/$(uid))
          || validPartnerProfile(resource.data)));
      allow list, delete: if false;
      allow create, update: if isOwner(uid)
        && validPartnerProfile(request.resource.data)
        && request.resource.data.name == getAfter(userPath(uid)).data.name
        && request.resource.data.get('photoUrl', null) == getAfter(userPath(uid)).data.get('photoUrl', null);
    }

    function validAuthors(authors) {
      return authors is list && authors.size() <= 50
        && (authors.size() <= 0 || authors[0] is string)
        && (authors.size() <= 1 || authors[1] is string)
        && (authors.size() <= 2 || authors[2] is string)
        && (authors.size() <= 3 || authors[3] is string)
        && (authors.size() <= 4 || authors[4] is string)
        && (authors.size() <= 5 || authors[5] is string)
        && (authors.size() <= 6 || authors[6] is string)
        && (authors.size() <= 7 || authors[7] is string)
        && (authors.size() <= 8 || authors[8] is string)
        && (authors.size() <= 9 || authors[9] is string)
        && (authors.size() <= 10 || authors[10] is string)
        && (authors.size() <= 11 || authors[11] is string)
        && (authors.size() <= 12 || authors[12] is string)
        && (authors.size() <= 13 || authors[13] is string)
        && (authors.size() <= 14 || authors[14] is string)
        && (authors.size() <= 15 || authors[15] is string)
        && (authors.size() <= 16 || authors[16] is string)
        && (authors.size() <= 17 || authors[17] is string)
        && (authors.size() <= 18 || authors[18] is string)
        && (authors.size() <= 19 || authors[19] is string)
        && (authors.size() <= 20 || authors[20] is string)
        && (authors.size() <= 21 || authors[21] is string)
        && (authors.size() <= 22 || authors[22] is string)
        && (authors.size() <= 23 || authors[23] is string)
        && (authors.size() <= 24 || authors[24] is string)
        && (authors.size() <= 25 || authors[25] is string)
        && (authors.size() <= 26 || authors[26] is string)
        && (authors.size() <= 27 || authors[27] is string)
        && (authors.size() <= 28 || authors[28] is string)
        && (authors.size() <= 29 || authors[29] is string)
        && (authors.size() <= 30 || authors[30] is string)
        && (authors.size() <= 31 || authors[31] is string)
        && (authors.size() <= 32 || authors[32] is string)
        && (authors.size() <= 33 || authors[33] is string)
        && (authors.size() <= 34 || authors[34] is string)
        && (authors.size() <= 35 || authors[35] is string)
        && (authors.size() <= 36 || authors[36] is string)
        && (authors.size() <= 37 || authors[37] is string)
        && (authors.size() <= 38 || authors[38] is string)
        && (authors.size() <= 39 || authors[39] is string)
        && (authors.size() <= 40 || authors[40] is string)
        && (authors.size() <= 41 || authors[41] is string)
        && (authors.size() <= 42 || authors[42] is string)
        && (authors.size() <= 43 || authors[43] is string)
        && (authors.size() <= 44 || authors[44] is string)
        && (authors.size() <= 45 || authors[45] is string)
        && (authors.size() <= 46 || authors[46] is string)
        && (authors.size() <= 47 || authors[47] is string)
        && (authors.size() <= 48 || authors[48] is string)
        && (authors.size() <= 49 || authors[49] is string);
    }
    function validBook(data) {
      return data.keys().hasAll(['userId', 'title', 'authors', 'coverUrl', 'status', 'publishedDate', 'addedAt'])
        && data.get('isShared', true) is bool
        && (data.get('activityAt', null) == null || data.activityAt is timestamp)
        && data.userId is string && data.title is string && data.title.size() > 0
        && validAuthors(data.authors)
        && data.coverUrl is string && data.publishedDate is string
        && data.status in ['Quero Ler', 'Lendo', 'Lido']
        && data.addedAt is timestamp
        && (data.get('googleBooksId', null) == null
          || (data.googleBooksId is string && data.googleBooksId.size() > 0 && data.googleBooksId.size() <= 200))
        && (data.get('finishedDate', null) == null || data.finishedDate is timestamp);
    }
    function validNewCompletion(data) {
      return (data.status == 'Lido' || data.get('finishedDate', null) == null)
        && (data.get('finishedDate', null) == null || data.finishedDate <= request.time);
    }
    function validActivityPointer(id, data, before) {
      return (!(data.keys().hasAny(['latestActivityAt'])) && !(before.keys().hasAny(['latestActivityAt']))) || (
        data.get('createdAt', null) == before.get('createdAt', null)
        && (data.latestActivityAt == before.get('latestActivityAt', null)
          ? data.get('activityEventId', null) == before.get('activityEventId', null)
            && data.get('activityStatus', null) == before.get('activityStatus', null)
            && data.get('activityAction', null) == before.get('activityAction', null)
            && data.status == before.status
          : data.latestActivityAt == request.time
            && data.activityAt == request.time
            && getAfter(/databases/$(database)/documents/books/$(id)/activity/$(data.activityEventId)).data.occurredAt == request.time
            && getAfter(/databases/$(database)/documents/books/$(id)/activity/$(data.activityEventId)).data.status == data.status));
    }
    match /books/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/books/$(id)) || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(['userId', 'title', 'authors', 'coverUrl', 'status', 'publishedDate', 'addedAt', 'finishedDate', 'googleBooksId', 'isShared', 'activityAt', 'createdAt', 'updatedAt', 'latestActivityAt', 'activityEventId', 'activityStatus', 'activityAction'])
        && validBook(request.resource.data) && validNewCompletion(request.resource.data)
        && (request.resource.data.get('activityAt', null) == null || request.resource.data.activityAt == request.time)
        && (!request.resource.data.keys().hasAny(['latestActivityAt']) || (
          request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.latestActivityAt == request.time
          && request.resource.data.activityAction == 'added' && request.resource.data.activityStatus == request.resource.data.status
          && getAfter(/databases/$(database)/documents/books/$(id)/activity/$(request.resource.data.activityEventId)).data.occurredAt == request.time));
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'title', 'authors', 'coverUrl', 'status', 'publishedDate', 'addedAt', 'finishedDate', 'googleBooksId', 'isShared', 'activityAt', 'createdAt', 'updatedAt', 'latestActivityAt', 'activityEventId', 'activityStatus', 'activityAction'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.addedAt == resource.data.addedAt
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && (request.resource.data.get('updatedAt', null) == resource.data.get('updatedAt', null) || request.resource.data.updatedAt == request.time)
        && validActivityPointer(id, request.resource.data, resource.data)
        && validBook(request.resource.data)
        && (request.resource.data.get('isShared', true) || !existsAfter(/databases/$(database)/documents/shared_books/$(id)))
        && (!existsAfter(/databases/$(database)/documents/shared_books/$(id))
          || sharedBookMatches(getAfter(/databases/$(database)/documents/shared_books/$(id)).data, request.resource.data))
        && (request.resource.data.get('activityAt', null) == resource.data.get('activityAt', null)
          || request.resource.data.activityAt == request.time
          || (request.resource.data.get('activityAt', null) == null
            && request.resource.data.get('isShared', true) != resource.data.get('isShared', true)))
        && (validNewCompletion(request.resource.data)
          || request.resource.data.get('finishedDate', null) == resource.data.get('finishedDate', null));
      allow delete: if isOwner(resource.data.userId)
        && !existsAfter(/databases/$(database)/documents/shared_books/$(id));
    }

    match /books/{bookId}/activity/{eventId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isOwner(get(/databases/$(database)/documents/books/$(bookId)).data.userId);
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasAll(['userId', 'bookId', 'action', 'beforeStatus', 'status', 'occurredAt'])
        && request.resource.data.keys().hasOnly(['userId', 'bookId', 'action', 'beforeStatus', 'status', 'occurredAt'])
        && request.resource.data.bookId == bookId && request.resource.data.occurredAt == request.time
        && getAfter(/databases/$(database)/documents/books/$(bookId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/books/$(bookId)).data.activityEventId == eventId
        && getAfter(/databases/$(database)/documents/books/$(bookId)).data.latestActivityAt == request.time
        && getAfter(/databases/$(database)/documents/books/$(bookId)).data.activityStatus == request.resource.data.status
        && getAfter(/databases/$(database)/documents/books/$(bookId)).data.activityAction == request.resource.data.action
        && ((request.resource.data.action == 'added' && request.resource.data.beforeStatus == null
            && !exists(/databases/$(database)/documents/books/$(bookId)))
          || (request.resource.data.action == 'status_changed'
            && request.resource.data.beforeStatus == get(/databases/$(database)/documents/books/$(bookId)).data.status
            && request.resource.data.status != request.resource.data.beforeStatus));
      allow update, delete: if false;
    }

    function sharedBookMatches(data, own) {
      return data.userId == own.userId && data.title == own.title
        && data.authors == own.authors && data.coverUrl == own.coverUrl
        && data.status == own.status && data.publishedDate == own.publishedDate
        && data.addedAt == own.addedAt
        && data.get('finishedDate', null) == own.get('finishedDate', null)
        && data.get('googleBooksId', null) == own.get('googleBooksId', null)
        && data.get('activityAt', null) == own.get('activityAt', null)
        && data.get('activityStatus', null) == own.get('activityStatus', null)
        && data.get('activityAction', null) == own.get('activityAction', null);
    }
    function minimalBook(data) {
      return data.keys().hasOnly(['userId', 'title', 'authors', 'coverUrl', 'status', 'publishedDate', 'addedAt', 'finishedDate', 'googleBooksId', 'activityAt', 'activityStatus', 'activityAction']);
    }
    match /shared_books/{id} {
      allow get: if signedIn() && ((!exists(/databases/$(database)/documents/shared_books/$(id))
        && isOwner(get(/databases/$(database)/documents/books/$(id)).data.userId)) || canRead(resource.data.userId));
      allow list: if canRead(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId)
        && minimalBook(request.resource.data)
        && getAfter(/databases/$(database)/documents/books/$(id)).data.get('isShared', true)
        && sharedBookMatches(request.resource.data, getAfter(/databases/$(database)/documents/books/$(id)).data);
      allow delete: if signedIn() && (!exists(/databases/$(database)/documents/shared_books/$(id)) || isOwner(resource.data.userId));
    }

