    function validListenDateOrFuture(value) {
      let parts = value.split('-');
      let year = int(parts[0]); let month = int(parts[1]); let day = int(parts[2]);
      let date = timestamp.date(year, month, day);
      return year >= 1 && date.year() == year && date.month() == month && date.day() == day;
    }
    function seriesEpisodeProjection(owner, entry, id) {
      let p = getAfter(/databases/$(database)/documents/shared_series/$(owner)/entries/$(entry)/episodes/$(id)).data;
      let s = getAfter(/databases/$(database)/documents/libraries/$(owner)/series/$(entry)/episodes/$(id)).data;
