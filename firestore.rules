      }
      allow read: if isOwner(owner);
      allow create: if isOwner(owner) && validEntry(request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/libraries/$(owner)/catalog/$(request.resource.data.catalogId)).data.mediaType == request.resource.data.mediaType
        && getAfter(/databases/$(database)/documents/libraries/$(owner)/reference_slots/$(getAfter(/databases/$(database)/documents/libraries/$(owner)/catalog/$(request.resource.data.catalogId)).data.catalogKey)).data.entryId == id;
      allow update: if isOwner(owner) && validEntry(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'favorite', 'updatedAt', 'revision'])
        && request.resource.data.revision == resource.data.revision + 1;
