        && (request.resource.data.fetchedAt == null || request.resource.data.fetchedAt is timestamp)
        && request.resource.data.catalogKey is string && request.resource.data.catalogKey.size() <= 1000
        && request.resource.data.catalogKey.matches('^[A-Za-z0-9_-]+$')
        && getAfter(/databases/$(database)/documents/libraries/$(owner)/reference_slots/$(request.resource.data.catalogKey)).data.catalogId == id;
    }
